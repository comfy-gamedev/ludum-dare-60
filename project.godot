; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Ludum Dare 60"
run/main_scene="uid://bj2io7eewnqlg"
config/features=PackedStringArray("4.8", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

SceneGirl="*uid://c6dqp4kex16cl"
Globals="*uid://deboqqs1s1564"

[display]

window/size/viewport_width=240
window/size/viewport_height=160
window/size/window_width_override=960
window/size/window_height_override=640
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[file_customization]

folder_colors={
"res://assets/": "green",
"res://entities/": "blue",
"res://entities/buildings/": "orange",
"res://systems/crafting/": "purple"
}

[filesystem]

import/blender/enabled=false

[gui]

common/auto_focus_strategy=1
theme/custom="uid://cxg141t68uyj7"
theme/custom_font="uid://cm3cxhvhfpph5"

