; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Ludum Dare 60"
run/main_scene="uid://bj2io7eewnqlg"
config/features=PackedStringArray("4.8", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

SceneGirl="*uid://c6dqp4kex16cl"
Globals="*uid://deboqqs1s1564"
MusicMan="*uid://bx1260lxdtgwn"

[display]

window/size/viewport_width=240
window/size/viewport_height=160
window/size/window_width_override=960
window/size/window_height_override=640
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[file_customization]

folder_colors={
"res://assets/": "green",
"res://entities/": "blue",
"res://entities/buildings/": "orange",
"res://systems/constructions/": "yellow",
"res://systems/crafting/": "purple"
}

[filesystem]

import/blender/enabled=false

[gui]

common/auto_focus_strategy=1
theme/custom="uid://cxg141t68uyj7"
theme/custom_font="uid://cm3cxhvhfpph5"

[importer_defaults]

ArrayMesh={
"_subresources": {},
"animation/fps": 30,
"animation/import": true,
"animation/import_rest_as_RESET": false,
"animation/remove_immutable_tracks": true,
"animation/trimming": false,
"array_mesh/deduplicate_surfaces": true,
"gltf/embedded_image_handling": 1,
"gltf/naming_version": 2,
"gltf/texture_map_mode": 1,
"import_script/path": "",
"materials/extract": 0,
"materials/extract_format": 0,
"materials/extract_path": "",
"mesh_library/create_categories_from_hierarchy": false,
"mesh_library/use_node_names_as_mesh_names": false,
&"meshes/create_shadow_meshes": false,
"meshes/ensure_tangents": true,
"meshes/force_disable_compression": false,
&"meshes/generate_lods": false,
"meshes/light_baking": 1,
"meshes/lightmap_texel_size": 0.2,
"nodes/apply_root_scale": true,
"nodes/import_as_skeleton_bones": false,
"nodes/root_name": "",
"nodes/root_scale": 1.0,
"nodes/root_script": null,
"nodes/root_type": "",
"nodes/use_name_suffixes": true,
"nodes/use_node_type_suffixes": true,
"skins/use_named_skins": true
}
scene={
&"meshes/create_shadow_meshes": false,
&"meshes/generate_lods": false
}

